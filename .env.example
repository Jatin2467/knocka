# ------------------------------------------------------------------
# Waitlist email (POST /api/waitlist)
#
# Copy this file to .env.local and fill in SMTP_PASS. .env.local is
# git-ignored; this file is committed and must never hold a secret.
#
# Each signup sends two emails: a notification to WAITLIST_OWNER_EMAIL
# and a confirmation to the person who signed up.
# ------------------------------------------------------------------

# Who gets notified of every signup.
WAITLIST_OWNER_EMAIL=jatin.apl1234@gmail.com
# WAITLIST_OWNER_EMAIL=nhunberto@gmail.com


# --- SMTP -----------------------------------------------------------
# Gmail: use an App Password, NOT your normal Google password.
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine, they are stripped).
# Gmail caps sending at roughly 500 emails a day. For more, point these
# at a transactional provider (Resend, Brevo, Postmark, SES) — no code
# changes needed.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS. Use 587 for STARTTLS. SMTP_SECURE is inferred from
# the port; set it to true/false only to override.
SMTP_PORT=465
SMTP_USER=jatin.apl1234@gmail.com
SMTP_PASS=

# Optional. Defaults to "Knocka" <SMTP_USER>. Gmail only sends as the
# signed-in account or a verified alias.
MAIL_FROM="Knocka <jatin.apl1234@gmail.com>"

# ------------------------------------------------------------------
# Firebase (project knocka-75c63) — web app config.
# Not secrets: these identify the project and ship to the browser, which is
# why they are NEXT_PUBLIC_. Access is controlled by Firestore rules, not by
# hiding these.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyApZNj7IDEcAZJdn3CfQw5OuHE5tYWAjVA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=knocka-75c63.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://knocka-75c63-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=knocka-75c63
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=knocka-75c63.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=7245529143
NEXT_PUBLIC_FIREBASE_APP_ID=1:7245529143:web:1393c32a1bc69c33753fb2
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-7DNBZYVXPR

# ------------------------------------------------------------------
# Waitlist database (server only).
# The landing page's own Firestore database in knocka-75c63 — NOT the mobile
# apps' (default). Leave unset to skip the Firestore write (email still
# works). The server refuses "(default)".
# Locally the Admin SDK needs credentials: run
#   gcloud auth application-default login
# On Firebase App Hosting they come from the backend's service account.
# ------------------------------------------------------------------
# FIRESTORE_DATABASE_ID=knocka-landing

# ------------------------------------------------------------------
# Outbound mail cap (optional). Messages per UTC day, shared by every instance
# through the landing database. Two per signup. Default 300.
# ------------------------------------------------------------------
# WAITLIST_MAIL_DAILY_CAP=300
# Tests only: use a private counter instead of today's real one. Never in production.
# WAITLIST_MAIL_QUOTA_SCOPE=my-test

# ------------------------------------------------------------------
# Firebase App Check for the waitlist API (reCAPTCHA Enterprise)
# The site key is PUBLIC (it ships to the browser) and has no secret half.
# On localhost the key does not work (it allows only the production domain);
# the browser uses Firebase's debug provider there, whose one-off token you
# register privately in the Firebase console. Never commit or ship a debug token.
# ------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=6LfUh9ktAAAAAI5GMyCpXvM4pinqGlomowhX09y-
# Server-only. false (default) = monitor and log; true = refuse requests without
# a valid token with 403. Never prefix with NEXT_PUBLIC_.
# APP_CHECK_ENFORCE=false
